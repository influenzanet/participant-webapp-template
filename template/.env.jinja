# App configuration (owned by this repo, never touched by copier update).
# Mode-specific overrides: .env.development, .env.production.local (Vite precedence).
REACT_APP_CONTENT_URL=/assets
REACT_APP_API_BASE_URL=/api
REACT_APP_DEFAULT_INSTANCE=
REACT_APP_DEFAULT_LANGUAGE="[[ date_locales[0].code ]]"
REACT_APP_FALLBACK_LANGUAGE="en"
REACT_APP_USE_RECAPTCHA=true
REACT_APP_RECAPTCHA_SITEKEY=
REACT_APP_TITLE="[[ app_title ]]"
REACT_APP_DESCRIPTION="[[ description ]]"
