[%- set base = {
  "@influenzanet/case-web-app-core": core_version,
  "@influenzanet/case-web-ui": ui_version,
  "@influenzanet/participant-webapp-kit": kit_version,
  "@popperjs/core": "^2.11.8",
  "bootstrap": "^5.1.3",
  "date-fns": "2.28.0",
  "encoding": "^0.1.13",
  "i18next": "^21.7.1",
  "react": "^17.0.2",
  "react-dom": "^17.0.2",
  "react-i18next": "^11.16.8",
  "react-redux": "^7.2.8",
  "redux": "^4.2.0",
  "survey-engine": survey_engine_version,
} -%]
[%- set deps = ((base.items() | list) + (extra_dependencies.items() | list)) | sort -%]
{
  "name": "[[ package_name ]]",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
[%- for k, v in deps %]
    "[[ k ]]": "[[ v ]]"[% if not loop.last %],[% endif %]
[%- endfor %]
  },
  "devDependencies": {
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "sass": "^1.99.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.2"
  },
  "resolutions": {
    "@babel/runtime": "^7.26.10",
    "@types/react": "^17.0.2",
    "lodash": "^4.18.0"
  }
}
